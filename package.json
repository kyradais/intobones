{
  "name": "intobones",
  "version": "0.1.0",
  "private": true,
  "description": "Splits a single character image into separate body-part images in one SVG for bones rigging.",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node tools/docs.js --check && node tests/run-all.js",
