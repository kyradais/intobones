    "docs": "node tools/docs.js",
    "check": "node tools/docs.js --check"
  },
  "license": "MIT",
  "devDependencies": {
    "acorn": "^8.12.0",
    "jsdom": "^24.0.0",
    "puppeteer-core": "^22.0.0",
    "@sparticuz/chromium": "^123.0.0"
  }
}
